<Window x:Class="KeyMend.UI.TrayMenuWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeyMend.UI"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" SizeToContent="WidthAndHeight" Opacity="0"
        WindowStartupLocation="Manual" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        FontFamily="{x:Static SystemFonts.MenuFontFamily}" FontSize="{x:Static SystemFonts.MenuFontSize}"
        Foreground="{DynamicResource Km.Text}"
        PreviewKeyDown="OnPreviewKeyDown" MouseLeave="OnMouseLeave">
    <Window.Resources>
        <!-- Строка меню: пункт (галочка, текст, вторая строка) или разделитель. Размеры по макету SPEC F10. -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:TrayMenuRow}">
            <Grid>
                <Border Height="1" Margin="4,4" Background="{DynamicResource Km.Line}"
                        Visibility="{Binding SeparatorVisibility}"/>
                <Border x:Name="Back" CornerRadius="4" Background="Transparent" Padding="10,0,12,0"
                        MinHeight="{Binding ItemHeight}" Visibility="{Binding ItemVisibility}"
                        AutomationProperties.Name="{Binding Entry.Text}"
                        MouseMove="OnRowMouseMove" MouseLeftButtonUp="OnRowMouseUp" MouseRightButtonUp="OnRowMouseUp">
                    <Grid VerticalAlignment="Center" Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path x:Name="Check" Width="16" Height="16" Data="M2.5,8.5 L6.5,12.5 L13.5,4" Stretch="None"
                              Stroke="{DynamicResource Km.AccentEdge}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Visibility="{Binding CheckVisibility}"/>
                        <StackPanel x:Name="Label" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Title" Text="{Binding Entry.Text}" LineHeight="16" LineStackingStrategy="BlockLineHeight"/>
                            <TextBlock Text="{Binding Entry.SecondLine}" LineHeight="16" LineStackingStrategy="BlockLineHeight"
                                       Foreground="{DynamicResource Km.Text2}" Visibility="{Binding SecondLineVisibility}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHot}" Value="True">
                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource Km.Selected}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Entry.IsDefault}" Value="True">
                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Entry.IsEnabled}" Value="False">
                    <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Km.TextDisabled}"/>
                    <Setter TargetName="Check" Property="Stroke" Value="{DynamicResource Km.TextDisabled}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- Поле вокруг меню нужно для тени: прозрачное окно по размеру содержимого её обрежет. -->
    <Grid Margin="16" MinWidth="288">
        <!-- Фон отдельно от содержимого: эффект тени иначе применился бы и к тексту. -->
        <Border CornerRadius="8" BorderThickness="1" Background="{DynamicResource Km.Menu}" BorderBrush="{DynamicResource Km.MenuLine}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.28" Color="Black"/>
            </Border.Effect>
        </Border>
        <ItemsControl x:Name="Rows" Margin="5" ItemTemplate="{StaticResource RowTemplate}" IsTabStop="False" Focusable="False"/>
    </Grid>
</Window>
