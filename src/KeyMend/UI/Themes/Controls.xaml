<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Стили окна настроек по макету (SPEC 5). Цвета берутся из палитры темы (Palette.*.xaml), поэтому меняются вместе с ней. -->
    <!-- Рамка клавиатурного фокуса: тонкая акцентная вместо белой пунктирной WPF; появляется после любой клавиши, в том числе PrintScreen. -->
    <Style x:Key="Km.Focus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="5" RadiusY="5" StrokeThickness="1.5" Stroke="{DynamicResource Km.AccentEdge}" IsHitTestVisible="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Km.CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Km.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Km.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="MinHeight" Value="64"/>
    </Style>

    <Style x:Key="Km.PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Km.Text}"/>
    </Style>

    <Style x:Key="Km.GroupTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Km.Text}"/>
        <Setter Property="Margin" Value="0,22,0,8"/>
    </Style>

    <Style x:Key="Km.CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Km.Text}"/>
    </Style>

    <Style x:Key="Km.CardHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Km.Text2}"/>
    </Style>

    <!-- Плашка клавиши в поле «Клавиши». -->
    <Style x:Key="Km.KeyChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Km.Card2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Km.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,2"/>
    </Style>

    <!-- Полоса ошибки, предупреждения или сведений под полем. -->
    <Style x:Key="Km.InfoBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Km.Card2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Km.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <!-- Сегмент «Одиночное / Двойное»: выбранный залит акцентом. -->
    <Style x:Key="Km.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Km.Text}"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Back" CornerRadius="4" Background="Transparent" BorderThickness="1"
                            BorderBrush="{DynamicResource Km.FieldLine}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource Km.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource Km.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Km.AccentText}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource Km.AccentEdge}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Поле числа без крестика очистки: рамка 32 px, текст у правого края. -->
    <ControlTemplate x:Key="Km.NumberBoxTemplate" TargetType="TextBox">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" MinHeight="32">
            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center"/>
        </Border>
    </ControlTemplate>

    <!-- Переключатель как в Windows 11: включённый залит акцентом, ползунок тёмно-серый. Подпись «Вкл./Откл.» рисует страница. -->
    <Style x:Key="Km.Switch" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Km.Focus}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="40" Height="20" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Track" CornerRadius="10" BorderThickness="1" Background="Transparent"
                                BorderBrush="{DynamicResource Km.Text2}"/>
                        <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                 Fill="{DynamicResource Km.Text2}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Km.Text}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Km.Text}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Km.Accent}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Km.AccentEdge}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Km.AccentText}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Чип-фильтр: выбранный залит акцентом. Внутри — название и число. -->
    <Style x:Key="Km.Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Km.Text}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Km.Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Back" CornerRadius="15" Background="{DynamicResource Km.Card}" BorderThickness="1"
                            BorderBrush="{DynamicResource Km.Line}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource Km.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource Km.Accent}"/>
                            <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource Km.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Km.AccentText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Главная кнопка: акцентная заливка и тёмно-серый текст. -->
    <Style x:Key="Km.AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Km.AccentText}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Km.Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Back" CornerRadius="4" Background="{DynamicResource Km.Accent}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопка-значок без рамки (⋯ в строке таблицы). -->
    <Style x:Key="Km.IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Km.Text}"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Km.Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Back" CornerRadius="4" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource Km.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Значок «?» в круге рядом с настройкой (F9); открытая подсказка закрашивает его акцентом из кода. -->
    <Style x:Key="Km.HelpButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Km.Text2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Km.Text2}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="Cursor" Value="Help"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Km.Focus}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="8" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <TextBlock Text="?" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Бейдж рядом с клавишами: «×2», «через 400 мс». -->
    <Style x:Key="Km.Badge" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Km.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="7,0"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Пункт меню разделов: 36 px, выделенный — серая подложка и голубая полоска слева. -->
    <Style x:Key="Km.NavItem" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Km.Text}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Back" CornerRadius="4" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"/>
                        <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{DynamicResource Km.AccentEdge}" Visibility="Collapsed"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource Km.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource Km.Selected}"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource Km.AccentEdge}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
