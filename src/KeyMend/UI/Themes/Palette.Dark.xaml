<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Палитра KeyMend (SPEC 5, F1): свой голубой акцент в обеих темах, тёмно-серый на нём. Подключается после Fluent и перекрывает его акцент. -->
    <SolidColorBrush x:Key="Km.Bg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Km.Card" Color="#252526"/>
    <SolidColorBrush x:Key="Km.Card2" Color="#2D2D30"/>
    <SolidColorBrush x:Key="Km.Line" Color="#3F3F46"/>
    <SolidColorBrush x:Key="Km.Text" Color="#F1F1F1"/>
    <SolidColorBrush x:Key="Km.Text2" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="Km.Accent" Color="#60CDFF"/>
    <SolidColorBrush x:Key="Km.AccentText" Color="#333333"/>
    <SolidColorBrush x:Key="Km.AccentInk" Color="#60CDFF"/>
    <SolidColorBrush x:Key="Km.AccentEdge" Color="#60CDFF"/>
    <SolidColorBrush x:Key="Km.Admin" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="Km.AdminText" Color="#333333"/>
    <SolidColorBrush x:Key="Km.Hover" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="Km.Selected" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Km.Field" Color="#2D2D30"/>
    <SolidColorBrush x:Key="Km.FieldLine" Color="#3F3F46"/>
    <SolidColorBrush x:Key="Km.FieldBottom" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Km.Menu" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="Km.MenuLine" Color="#3F3F46"/>
    <SolidColorBrush x:Key="Km.TextDisabled" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="Km.Error" Color="#FF99A4"/>
    <SolidColorBrush x:Key="Km.Warning" Color="#FCE100"/>

    <!-- Акцент Fluent: вместо системного — наш голубой. -->
    <Color x:Key="SystemAccentColor">#60CDFF</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#60CDFF" Opacity="0.9"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#60CDFF" Opacity="0.8"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#333333"/>
</ResourceDictionary>
