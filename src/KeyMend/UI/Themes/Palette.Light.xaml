<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Палитра KeyMend (SPEC 5, F1): свой голубой акцент в обеих темах, тёмно-серый на нём. Подключается после Fluent и перекрывает его акцент. -->
    <SolidColorBrush x:Key="Km.Bg" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Km.Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Km.Card2" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="Km.Line" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="Km.Text" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="Km.Text2" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="Km.Accent" Color="#60CDFF"/>
    <SolidColorBrush x:Key="Km.AccentText" Color="#333333"/>
    <SolidColorBrush x:Key="Km.AccentInk" Color="#0067A3"/>
    <SolidColorBrush x:Key="Km.AccentEdge" Color="#1A86C2"/>
    <SolidColorBrush x:Key="Km.Admin" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="Km.AdminText" Color="#333333"/>
    <SolidColorBrush x:Key="Km.Hover" Color="#0A000000"/>
    <SolidColorBrush x:Key="Km.Selected" Color="#0F000000"/>
    <SolidColorBrush x:Key="Km.Field" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Km.FieldLine" Color="#D1D1D1"/>
    <SolidColorBrush x:Key="Km.FieldBottom" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Km.Menu" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="Km.MenuLine" Color="#DADADA"/>
    <SolidColorBrush x:Key="Km.TextDisabled" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Km.Error" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Km.Warning" Color="#9D5D00"/>

    <!-- Акцент Fluent: вместо системного — наш голубой. -->
    <Color x:Key="SystemAccentColor">#60CDFF</Color>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#60CDFF" Opacity="0.9"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#60CDFF" Opacity="0.8"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#333333"/>
</ResourceDictionary>
