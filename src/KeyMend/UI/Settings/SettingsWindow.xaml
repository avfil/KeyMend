<Window x:Class="KeyMend.UI.Settings.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeyMend.UI.Settings"
        Width="1120" Height="760" MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Km.Bg}" Foreground="{DynamicResource Km.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        PreviewMouseDown="OnWindowMouseDown">
    <Window.Resources>
            <!-- Пункт меню: значок на сетке 16×16 и название. -->
            <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type local:SectionItem}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{Binding IconPath}" Width="16" Height="16" Stretch="None"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    <TextBlock Text="{Binding Title}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="288"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="12,4,8,16" LastChildFill="True">
            <!-- Состояние программы: логотип и строка. -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,12,8,18">
                <local:LogoMark x:Name="Logo"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AppNameText" FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDotShape" Width="8" Height="8" Margin="0,1,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource Km.Text2}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Поиск по параметрам появится вместе с наполненными разделами. -->
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="4,0,4,10" IsEnabled="False" Height="32"/>

            <ListBox x:Name="BottomMenu" DockPanel.Dock="Bottom" BorderThickness="0" Background="Transparent" FocusVisualStyle="{x:Null}" PreviewKeyDown="OnMenuKeyDown"
                     ItemContainerStyle="{StaticResource Km.NavItem}" ItemTemplate="{StaticResource NavItemTemplate}"
                     SelectionChanged="OnMenuSelectionChanged"/>
            <ListBox x:Name="TopMenu" BorderThickness="0" Background="Transparent" FocusVisualStyle="{x:Null}" PreviewKeyDown="OnMenuKeyDown"
                     ItemContainerStyle="{StaticResource Km.NavItem}" ItemTemplate="{StaticResource NavItemTemplate}"
                     SelectionChanged="OnMenuSelectionChanged"/>
        </DockPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="PageTitle" Style="{StaticResource Km.PageTitle}" Margin="24,10,40,22"/>
            <ScrollViewer x:Name="PageScroll" Grid.Row="1" Focusable="False" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" Padding="24,0,40,40">
                <ContentControl x:Name="PageHost" IsTabStop="False" Focusable="True" FocusVisualStyle="{x:Null}"/>
            </ScrollViewer>
            <!-- Нижняя панель редактора лежит поверх прокручиваемого содержимого. -->
            <ContentControl x:Name="BarHost" Grid.Row="1" VerticalAlignment="Bottom" Margin="24,0,40,16" IsTabStop="False" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
