{
  "schemaVersion": 1,
  "theme": "System",
  "rules": [
    {
      "id": "lang",
      "name": "Язык",
      "enabled": true,
      "processes": [],
      "trigger": {
        "kind": "Tap",
        "keys": "RCtrl",
        "maxHoldMs": 150
      },
      "steps": [
        {
          "kind": "SwitchLayout",
          "mode": "Pair",
          "pair": [
            "ru-RU",
            "en-US"
          ]
        }
      ]
    },
    {
      "id": "who",
      "name": "Проверка прав",
      "enabled": true,
      "processes": [],
      "trigger": {
        "kind": "Press",
        "keys": "F13"
      },
      "steps": [
        {
          "kind": "Launch",
          "type": "Cmd",
          "file": "who.cmd",
          "window": "Hidden",
          "wait": true
        }
      ]
    }
  ],
  "snippets": [],
  "exclusions": []
}
