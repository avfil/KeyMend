{
  "schemaVersion": 1,
  "theme": "System",
  "rules": [
    {
      "id": "lang",
      "name": "Язык",
      "enabled": true,
      "processes": [],
      "trigger": {
        "kind": "Tap",
        "keys": "RCtrl",
        "maxHoldMs": 150
      },
      "steps": [
        {
          "kind": "SwitchLayout",
          "mode": "Pair",
          "pair": [
            "ru-RU",
            "en-US"
          ]
        }
      ]
    },
    {
      "id": "restart",
      "name": "Перезагрузка",
      "enabled": true,
      "processes": [],
      "trigger": {
        "kind": "Press",
        "keys": "F13"
      },
      "steps": [
        {
          "kind": "Power",
          "action": "Restart"
        }
      ]
    }
  ],
  "snippets": [],
  "exclusions": []
}
